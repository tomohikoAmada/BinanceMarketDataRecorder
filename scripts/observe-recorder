#!/bin/sh
set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Run tools/observe_vps_recorder.py using either the virtualenv python or active python
if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    PYTHON="$REPO_ROOT/.venv/bin/python"
elif [ -x "/opt/binance-market-data-recorder/venv/bin/python" ]; then
    PYTHON="/opt/binance-market-data-recorder/venv/bin/python"
else
    PYTHON="$(command -v python3 || command -v python)"
fi

exec "$PYTHON" "$REPO_ROOT/tools/observe_vps_recorder.py" "$@"
