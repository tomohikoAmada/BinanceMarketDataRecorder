+            symbol="BTCUSDT",
+            last_persisted_period_timestamp=99_000,
+            updated_at_utc_ns=99_001,
+            source_retention_window="latest_30_days",
+            retention_window_ms=30 * 24 * 60 * 60 * 1000,
+        )
