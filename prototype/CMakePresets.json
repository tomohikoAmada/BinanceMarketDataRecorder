{
  "version": 5,
  "configurePresets": [
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vcpkg-release",
      "inherits": "release",
      "binaryDir": "${sourceDir}/out/vcpkg-release",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "release"},
    {"name": "vcpkg-release", "configurePreset": "vcpkg-release"}
  ],
  "testPresets": [
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "vcpkg-release", "configurePreset": "vcpkg-release", "output": {"outputOnFailure": true}}
  ]
}
